    given-names: Anand
    affiliation: Syracuse University
version: 0.1.0
date-released: 2026-10-14
license: MIT
repository-code: "https://github.com/anandswadurkar/Computational-Small-Angle-X-ray-Scattering-SAXS-and-Nuclear-Magnetic-Resonance-NMR-for-Biomolecules"
keywords:
  - small-angle X-ray scattering
  - small-angle neutron scattering
  - nuclear magnetic resonance
  - molecular dynamics
  - structural biology
